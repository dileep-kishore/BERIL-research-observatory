{
  "mcpServers": {
    "pubmed": {
      "type": "http",
      "url": "https://pubmed.mcp.claude.com/mcp"
    },
    "paper-search": {
      "command": "uvx",
      "args": ["--from", "paper-search-mcp", "python", "-m", "paper_search_mcp.server"],
      "env": {
        "SEMANTIC_SCHOLAR_API_KEY": "${SEMANTIC_SCHOLAR_API_KEY:-}"
      }
    },
    "observatory-graph": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--extra", "graph", "python", "-m", "observatory_context.graph.server"]
    }
  }
}
